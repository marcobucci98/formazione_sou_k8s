pipeline {
    agent { label 'jenkins-agent' }

    environment {
        IMAGE_TAG = ''
        DOCKER_IMAGE = 'marcobuccidev/flask-app-example-build'
    }

    stages {
        stage('Checkout & Setup Tag') {
            steps {
                script {
                    dir('Track2-Step2-WEB-APP') {
                        def gitTag = sh(script: 'git tag --points-at HEAD', returnStdout: true).trim()
                        
                        def branchName = env.BRANCH_NAME ?: env.GIT_BRANCH?.replace('origin/', '')
                        if (!branchName) {
                            branchName = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                        }
                        
                        def shortCommit = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                        if (gitTag) {
                            env.IMAGE_TAG = gitTag
                            echo "Build da tag Git: ${gitTag}"
                        } else if (branchName == 'main' || branchName == 'master') {
                            env.IMAGE_TAG = 'latest'
                            echo "Build da branch master/main: tag 'latest'"
                        } else if (branchName == 'develop') {
                            env.IMAGE_TAG = "develop-${shortCommit}"
                            echo "Build da branch develop: tag '${env.IMAGE_TAG}'"
                        } else {
                            env.IMAGE_TAG = "build-${env.BUILD_NUMBER}"
                            echo "Build da branch '${branchName}': tag '${env.IMAGE_TAG}'"
                        }

                        echo "Docker Image Tag finale: ${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dir('Track2-Step2-WEB-APP') {
                        sh "docker build -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ."
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker-hub', 
                        usernameVariable: 'DOCKER_USER', 
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                        sh "docker push ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh 'docker logout || true'
            }
        }
    }
}