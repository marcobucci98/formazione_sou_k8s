pipeline {
    agent { label 'jenkins-agent' }

    environment {
        DOCKER_USER  = 'marcobuccidev'
        IMAGE_NAME   = 'flask-app-example-build'
        DOCKER_CREDS = 'docker-hub'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Tag') {
            steps {
                script {
                    def gitSha = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    
                    def gitTag = sh(script: "git tag --points-at HEAD", returnStdout: true).trim()
                    
                    def branchName = env.BRANCH_NAME ?: sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()

                    if (gitTag != '') {
                        env.IMAGE_TAG = gitTag
                        echo "Build da Git Tag: ${env.IMAGE_TAG}"
                    } else if (branchName == 'master' || branchName == 'main') {
                        env.IMAGE_TAG = 'latest'
                        echo "Build da branch master: tag impostato a ${env.IMAGE_TAG}"
                    } else if (branchName == 'develop') {
                        env.IMAGE_TAG = "develop-${gitSha}"
                        echo "Build da branch develop: tag impostato a ${env.IMAGE_TAG}"
                    } 
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${env.DOCKER_USER}/${env.IMAGE_NAME}:${env.IMAGE_TAG} ."
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: env.DOCKER_CREDS, usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                        sh "echo \$PASS | docker login -u \$USER --password-stdin"
                        sh "docker push ${env.DOCKER_USER}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                        sh "docker logout"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.IMAGE_TAG) {
                    sh "docker rmi ${env.DOCKER_USER}/${env.IMAGE_NAME}:${env.IMAGE_TAG} || true"
                }
            }
        }
    } 
}