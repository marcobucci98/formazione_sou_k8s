pipeline {
    agent any

    environment {
        // Dichiarazione globale per renderla accessibile in tutti gli stage
        IMAGE_TAG = ''
    }

    stages {
        stage('Checkout & Setup Tag') {
            steps {
                script {
                    dir('Track2-Step2-WEB-APP') {
                        // Recupera il tag Git se presente sul commit corrente
                        def gitTag = sh(script: 'git tag --points-at HEAD', returnStdout: true).trim()
                        
                        // Recupera il nome del branch reale
                        def branchName = env.BRANCH_NAME ?: env.GIT_BRANCH?.replace('origin/', '')
                        if (!branchName) {
                            branchName = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                        }
                        
                        def shortCommit = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                        // Logica dinamica di Tagging
                        if (gitTag) {
                            env.IMAGE_TAG = gitTag
                        } else if (branchName == 'main' || branchName == 'master') {
                            env.IMAGE_TAG = 'latest'
                        } else if (branchName == 'develop') {
                            env.IMAGE_TAG = "develop-${shortCommit}"
                        } else {
                            env.IMAGE_TAG = "build-${env.BUILD_NUMBER}"
                        }

                        echo "Tag generato per Docker: ${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dir('Track2-Step2-WEB-APP') {
                        sh "docker build -t marcobuccidev/flask-app-example-build:${env.IMAGE_TAG} /home/vagrant"
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    dir('Track2-Step2-WEB-APP') {
                        withCredentials([usernamePassword(credentialsId: 'docker-hub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                            sh "docker push marcobuccidev/flask-app-example-build:${env.IMAGE_TAG}"
                        }
                    }
                }
            }
        }
    }
}